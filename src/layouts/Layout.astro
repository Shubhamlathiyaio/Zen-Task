---
import '../styles/global.css';
import { pwaInfo } from 'virtual:pwa-info';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Boost your productivity with ChronosFocus. Combine a Pomodoro timer, habit tracking, and a powerful task management system to get your best work done." />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta property="og:title" content="ChronosFocus | Gamified Focus and Task Management App" />
    <meta property="og:description" content="Boost your productivity with ChronosFocus. Combine a Pomodoro timer, habit tracking, and a powerful task management system to get your best work done." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cronosfocus.com/" />
    <meta property="og:image" content="https://cronosfocus.com/og-image.jpg" />
    <meta property="og:site_name" content="ChronosFocus" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="ChronosFocus | Gamified Focus and Task Management App" />
    <meta name="twitter:description" content="Boost your productivity with ChronosFocus. Combine a Pomodoro timer, habit tracking, and a powerful task management system to get your best work done." />
    <meta name="twitter:image" content="https://cronosfocus.com/og-image.jpg" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Varela+Round&display=swap" rel="stylesheet">
    
    <link rel="apple-touch-icon" href="/icon.jpg">
    { pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} /> }
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body class="bg-(--color-neutral) text-(--color-on-surface) min-h-screen">
    <slot />
    <script>
      import { registerSW } from 'virtual:pwa-register';

      registerSW({
        immediate: true,
        onRegisteredSW(swScriptUrl, registration) {
          console.log('SW registered: ', registration);
        },
        onRegisterError(error) {
          console.log('SW registration error', error);
        }
      });
    </script>
  </body>
</html>
